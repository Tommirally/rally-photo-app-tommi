# Copy to .env.local for local development, or add each line in
# Vercel → Project → Settings → Environment Variables.
# See README → "Connect Supabase and Cloudflare R2" for where each value lives.

# ---- Supabase (public: safe in the browser, protected by row level security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# ---- Supabase (SECRET: server only, never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_replace_me

# ---- Admin area: emails allowed into /admin (comma-separated). Server only.
ADMIN_EMAILS=you@example.com

# ---- Cloudflare R2 (SECRET: server only)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=rally-photos
# Optional. Leave empty for the normal endpoint
# (https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com). Set it for an
# EU-jurisdiction bucket (https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com)
# or a local emulator.
R2_ENDPOINT=
